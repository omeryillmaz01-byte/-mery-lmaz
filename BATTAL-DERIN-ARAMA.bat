@echo off
chcp 65001 >nul
title BATTAL - DERIN ARAMA (salt okunur)
setlocal
echo.
echo  ==================================================
echo    BATTAL MUHASEBE - DERIN ARAMA
echo    Tarayici gecmisi + Son kullanilanlar + Tum diskler
echo    HICBIR SEY degistirilmez, sadece listelenir.
echo  ==================================================
echo.
echo   NOT: Tarayici gecmisi icin Chrome kapali olursa daha iyi sonuc verir.
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='SilentlyContinue'; $masa=[Environment]::GetFolderPath('Desktop'); $sat=@(); $sat += ('TARAMA: ' + (Get-Date).ToString('dd.MM.yyyy HH:mm')); $sat += ''; $sat += '=== 1) TARAYICI GECMISINDE ACILAN file:// PANELLERI ==='; $sat += '    (paneli tarayicida actiysaniz tam yolu burada cikar)'; $gecmisler=@(); foreach($p in @('Google\Chrome','Microsoft\Edge','BraveSoftware\Brave-Browser')){ $kok=Join-Path $env:LOCALAPPDATA (Join-Path $p 'User Data'); if(Test-Path -LiteralPath $kok){ $gecmisler += (Get-ChildItem -LiteralPath $kok -Recurse -Depth 1 -Filter 'History' -File -ErrorAction SilentlyContinue) } }; $urlSet=@{}; foreach($h in $gecmisler){ $tmp=Join-Path $env:TEMP ('hist_' + [guid]::NewGuid().ToString('N') + '.db'); Copy-Item -LiteralPath $h.FullName -Destination $tmp -Force -ErrorAction SilentlyContinue; if(Test-Path -LiteralPath $tmp){ $by=[System.IO.File]::ReadAllBytes($tmp); $tx=[System.Text.Encoding]::ASCII.GetString($by); foreach($m in [regex]::Matches($tx,'file:///[A-Za-z0-9%/:._+-]{4,300}\.html')){ $urlSet[$m.Value]=$h.FullName }; Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue } }; if($urlSet.Count -eq 0){ $sat += '   (bulunamadi - tarayici acikken kilitli olabilir; tarayiciyi kapatip tekrar deneyin)' }; foreach($u in ($urlSet.Keys | Sort-Object)){ $ad=[System.Uri]::UnescapeDataString($u); $isaret='   '; if($ad -match '(?i)battal|muhasebe|musavir|defter'){ $isaret=' * ' }; $sat += ($isaret + $ad) }; $sat += ''; $sat += '=== 2) WINDOWS SON KULLANILANLAR (Recent) ==='; $sh=New-Object -ComObject WScript.Shell; $rec=Join-Path $env:APPDATA 'Microsoft\Windows\Recent'; $recN=0; if(Test-Path -LiteralPath $rec){ foreach($l in (Get-ChildItem -LiteralPath $rec -Filter '*.lnk' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)){ $t=($sh.CreateShortcut($l.FullName)).TargetPath; if($t -match '(?i)\.html?$'){ $recN++; $isaret='   '; if($t -match '(?i)battal|muhasebe|musavir|defter'){ $isaret=' * ' }; $sat += ($isaret + $l.LastWriteTime.ToString('dd.MM.yyyy HH:mm') + '  ' + $t) } } }; if($recN -eq 0){ $sat += '   (html kaydi yok)' }; $sat += ''; $atla='\\Windows\\|\\Program Files|\\ProgramData\\|\\AppData\\|node_modules|Recycle|\\WinSxS\\|\\Temp\\'; $surucular = Get-PSDrive -PSProvider FileSystem | Where-Object { $_.Root -match '^[A-Za-z]:.$' } | Select-Object -ExpandProperty Root; Write-Host ('  Surucular: ' + ($surucular -join '  ') + '   taraniyor, birkac dakika surebilir...'); $hepsi=@(); foreach($r in $surucular){ Write-Host ('    ' + $r); $b=@(Get-ChildItem -LiteralPath $r -Recurse -File -Filter '*.htm*' -ErrorAction SilentlyContinue | Where-Object { $_.FullName -notmatch $atla }); $hepsi += $b }; $hepsi = $hepsi | Sort-Object FullName -Unique; $sat += ('=== 3) DISKTEKI TUM HTML: ' + $hepsi.Count + ' dosya ==='); $sat += '--- adinda battal/musavir/muhasebe/defter/beyan/db gecenler ---'; $ada = $hepsi | Where-Object { $_.Name -match '(?i)battal|musavir|muhasebe|defter|beyan|db_' } | Sort-Object LastWriteTime -Descending; if($ada.Count -eq 0){ $sat += '   (yok)' }; foreach($f in $ada){ $sat += ('   ' + ([math]::Round($f.Length/1KB,0)).ToString().PadLeft(7) + ' KB  ' + $f.LastWriteTime.ToString('dd.MM.yyyy HH:mm') + '  ' + $f.FullName) }; $sat += ''; $sat += '--- HUB ADAYLARI: icinde 3+ farkli .html referansi gecenler ---'; $hub=@(); $n=0; foreach($f in $hepsi){ if($n -ge 600){ break }; if($f.Length -lt 4000 -or $f.Length -gt 30000000){ continue }; $n++; $ic=Get-Content -LiteralPath $f.FullName -Raw -ErrorAction SilentlyContinue; if(-not $ic){ continue }; $refs=@([regex]::Matches($ic,'(?i)[A-Za-z0-9_.-]+\.html') | ForEach-Object { $_.Value.ToLower() } | Select-Object -Unique); if($refs.Count -ge 3){ $hub += [pscustomobject]@{ Yol=$f.FullName; B=$f.Length; T=$f.LastWriteTime; S=$refs.Count; O=(($refs | Select-Object -First 6) -join ', ') } } }; $hub = $hub | Sort-Object S -Descending; if($hub.Count -eq 0){ $sat += '   (yok)' }; foreach($h in $hub){ $sat += ('   ' + ([string]$h.S).PadLeft(3) + ' panel  ' + ([math]::Round($h.B/1KB,0)).ToString().PadLeft(7) + ' KB  ' + $h.T.ToString('dd.MM.yyyy HH:mm') + '  ' + $h.Yol); $sat += ('              ' + $h.O) }; $sat += ''; $sat += '=== 4) GERI DONUSUM KUTUSU ==='; $shA=New-Object -ComObject Shell.Application; $rb=$shA.Namespace(0xA); $rbn=0; if($rb){ foreach($it in $rb.Items()){ if($it.Name -match '(?i)battal|muhasebe|musavir|defter' -or $it.Name -match '(?i)\.html?$'){ $rbn++; $sat += ('   ' + $it.Name + '   <- ' + $rb.GetDetailsOf($it,1)) } } }; if($rbn -eq 0){ $sat += '   (ilgili silinmis dosya yok)' }; $cikti=Join-Path $masa 'BATTAL-ARAMA-SONUC.txt'; $sat | Out-File -LiteralPath $cikti -Encoding UTF8; Write-Host ''; foreach($m in $sat){ Write-Host $m }; Write-Host ''; Write-Host ('  Sonuc: ' + $cikti) -ForegroundColor Green; Start-Process notepad.exe $cikti"
echo.
pause
