@echo off
chcp 65001 >nul
title KOMUTA MERKEZI - Kurulum
setlocal
set "KLASOR=%~dp0"
echo.
echo  ==================================================
echo    KOMUTA MERKEZI - TOPLU KURULUM
echo    Tum paneller Masaustu\PANELLER klasorunde
echo    bir araya getirilir ve kisayol olusturulur.
echo  ==================================================
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='SilentlyContinue'; $masa=[Environment]::GetFolderPath('Desktop'); $hedef=Join-Path $masa 'PANELLER'; if(-not (Test-Path -LiteralPath $hedef)){ New-Item -ItemType Directory -Path $hedef | Out-Null }; $kaynaklar=@('%KLASOR%', (Join-Path $masa 'BATTAL-MUSAVIR'), (Join-Path $masa 'BATTAL-MUHASEBE'), (Join-Path $masa 'KURTARILAN-PANELLER-2'), (Join-Path $masa 'KURTARILAN-PANELLER'), $masa, (Join-Path $env:USERPROFILE 'Downloads')); $kaynaklar = $kaynaklar | Select-Object -Unique; $gerek=@('KOMUTA-MERKEZI.html','KOMUTA-IS.html','KOMUTA-KISISEL.html','MUSAVIR_PRO_PANEL.html','MusavirPro_DefterBeyanAPI.html','MusavirPro_FaturaKontrol.html','DB_GIDER_KONTROL.html','BATTAL-MUHASEBE.html','BATTAL_MUHASEBE_DB_PRO.html','KGK-Sinav-Paneli.html','Soru-Paneli.html','SAGLIK-SPOR-DIYET-PANEL_v3.html'); $ok=0; $eksik=@(); foreach($ad in $gerek){;   $bul=$null;   foreach($k in $kaynaklar){ if(Test-Path -LiteralPath $k){ $c=@(Get-ChildItem -LiteralPath $k -Recurse -File -Filter $ad -ErrorAction SilentlyContinue | Sort-Object Length -Descending) ; if($c.Count -gt 0){ $bul=$c[0]; break } } };   if($bul){ Copy-Item -LiteralPath $bul.FullName -Destination (Join-Path $hedef $ad) -Force; $ok++; Write-Host ('  [OK]    ' + $ad.PadRight(34) + ([math]::Round($bul.Length/1KB,0)) + ' KB') } else { $eksik += $ad; Write-Host ('  [EKSIK] ' + $ad) -ForegroundColor Yellow }; }; $td=Join-Path $hedef 'TRENDYO'; if(-not (Test-Path -LiteralPath $td)){ New-Item -ItemType Directory -Path $td | Out-Null }; $tb=$null; foreach($k in $kaynaklar){ if(Test-Path -LiteralPath $k){ $c=@(Get-ChildItem -LiteralPath $k -Recurse -File -Filter 'Trendyol2MusavirPro.html' -ErrorAction SilentlyContinue | Sort-Object Length -Descending); if($c.Count -gt 0){ $tb=$c[0]; break } } }; if($tb){ Copy-Item -LiteralPath $tb.FullName -Destination (Join-Path $td 'Trendyol2MusavirPro.html') -Force; $ok++; Write-Host ('  [OK]    TRENDYO\Trendyol2MusavirPro.html') } else { $eksik += 'TRENDYO\Trendyol2MusavirPro.html'; Write-Host '  [EKSIK] TRENDYO\Trendyol2MusavirPro.html' -ForegroundColor Yellow }; Write-Host ''; $ana=Join-Path $hedef 'KOMUTA-MERKEZI.html'; if(Test-Path -LiteralPath $ana){;   $s=New-Object -ComObject WScript.Shell;   $ad2=[char]::ConvertFromUtf32(0x1F3AF) + ' KOMUTA MERKEZI.lnk';   $lnk=Join-Path $masa $ad2;   $k2=$s.CreateShortcut($lnk); $k2.TargetPath=$ana; $k2.WorkingDirectory=$hedef; $k2.Description='Komuta Merkezi - IS ve KISISEL'; $k2.Save();   Write-Host ('  [OK] Masaustu kisayolu: ' + $ad2) -ForegroundColor Green;   $eskiAd=[char]::ConvertFromUtf32(0x1F9FE) + ' BATTAL MUHASEBE.lnk';   $eski=Join-Path $masa $eskiAd;   if(Test-Path -LiteralPath $eski){ $k3=$s.CreateShortcut($eski); $k3.TargetPath=$ana; $k3.WorkingDirectory=$hedef; $k3.Save(); Write-Host '  [OK] BATTAL MUHASEBE kisayolu da buraya yonlendirildi.' -ForegroundColor Green }; } else { Write-Host '  [HATA] KOMUTA-MERKEZI.html bulunamadi, kisayol yapilamadi.' -ForegroundColor Red }; Write-Host ''; Write-Host ('  ' + $ok + ' dosya hazir. Klasor: ' + $hedef) -ForegroundColor Green; if($eksik.Count -gt 0){ Write-Host ('  Eksik: ' + ($eksik -join ', ')) -ForegroundColor Yellow }; Write-Host '  Not: Banka ve Beyanname-Oto sekmeleri .bat baslaticilarina bagli, onlar ayri kurulum ister.'; Start-Process $hedef"
echo.
pause
