@echo off
chcp 65001 >nul
title ZIP KURTARMA - Arsivleri Kurtar ve Ac
setlocal
echo.
echo  ==================================================
echo    GERI DONUSUMDEKI ZIP ARSIVLERI
echo    Battal_Muhasebe_Kurulum_v10.zip ve digerleri
echo    kurtarilir, acilir ve icindeki paneller listelenir.
echo.
echo    Geri donusum kutusu BOSALTILMAZ.
echo  ==================================================
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='SilentlyContinue'; $masa=[Environment]::GetFolderPath('Desktop'); $kok=Join-Path $masa 'KURTARILAN-ZIP'; $ham=Join-Path $kok '_zipler'; $ac=Join-Path $kok '_acilmis'; foreach($d in @($kok,$ham,$ac)){ if(-not (Test-Path -LiteralPath $d)){ New-Item -ItemType Directory -Path $d | Out-Null } }; $sh=New-Object -ComObject Shell.Application; $rb=$sh.Namespace(0xA); if(-not $rb){ Write-Host '  [HATA] Geri donusum kutusu okunamadi.' -ForegroundColor Red; exit 1 }; Write-Host '  ZIP dosyalari kurtariliyor...'; $i=0; foreach($it in $rb.Items()){;   if($it.Name -notmatch '(?i)\.zip$'){ continue };   if($it.Name -notmatch '(?i)battal|kurulum|panel|muhasebe'){ continue };   $i++;   $alt=Join-Path $ham ('{0:d2}' -f $i);   if(-not (Test-Path -LiteralPath $alt)){ New-Item -ItemType Directory -Path $alt | Out-Null };   $dh=$sh.Namespace($alt);   if($dh){ $dh.CopyHere($it,16) };   Write-Host ('    ' + ('{0:d2}' -f $i) + '  ' + $it.Name + '   silinme: ' + $rb.GetDetailsOf($it,2)); }; Start-Sleep -Seconds 8; Write-Host ''; Write-Host '  Arsivler aciliyor...'; $zipler=@(Get-ChildItem -LiteralPath $ham -Recurse -File -Filter '*.zip' -ErrorAction SilentlyContinue); foreach($z in $zipler){ $hedefAd=($z.BaseName -replace '[\\/:*?<>|]','-'); $h=Join-Path $ac $hedefAd; if(-not (Test-Path -LiteralPath $h)){ New-Item -ItemType Directory -Path $h | Out-Null }; Expand-Archive -LiteralPath $z.FullName -DestinationPath $h -Force -ErrorAction SilentlyContinue; Write-Host ('    acildi: ' + $z.Name) }; Write-Host ''; $sat=@(); $sat += ('ZIP KURTARMA: ' + (Get-Date).ToString('dd.MM.yyyy HH:mm')); $sat += ('Kurtarilan zip: ' + $zipler.Count); $sat += ''; $sat += '=== ARSIVLERDEN CIKAN HTML DOSYALARI (hub adaylari basta) ==='; $htmls=@(Get-ChildItem -LiteralPath $ac -Recurse -File -ErrorAction SilentlyContinue | Where-Object { $_.Extension -match '^\.html?$' }); $liste=@(); foreach($f in $htmls){ $ic=Get-Content -LiteralPath $f.FullName -Raw -ErrorAction SilentlyContinue; $n=0; if($ic){ $n=@([regex]::Matches($ic,'(?i)[A-Za-z0-9_.-]+\.html') | ForEach-Object { $_.Value.ToLower() } | Select-Object -Unique).Count }; $liste += [pscustomobject]@{ S=$n; B=$f.Length; Y=$f.FullName } }; $liste = $liste | Sort-Object S -Descending; if($liste.Count -eq 0){ $sat += '   (arsivlerde html yok)' }; foreach($x in $liste){ $sat += ('   ' + ([string]$x.S).PadLeft(3) + ' panel-ref  ' + ([math]::Round($x.B/1KB,0)).ToString().PadLeft(7) + ' KB  ' + $x.Y.Substring($ac.Length)) }; $sat += ''; $sat += '=== ARSIVLERDEKI TUM DOSYALAR ==='; foreach($f in (Get-ChildItem -LiteralPath $ac -Recurse -File -ErrorAction SilentlyContinue)){ $sat += ('   ' + ([math]::Round($f.Length/1KB,0)).ToString().PadLeft(7) + ' KB  ' + $f.FullName.Substring($ac.Length)) }; $cikti=Join-Path $masa 'ZIP-KURTARMA-SONUC.txt'; $sat | Out-File -LiteralPath $cikti -Encoding UTF8; foreach($m in $sat){ Write-Host $m }; Write-Host ''; Write-Host ('  Klasor: ' + $ac) -ForegroundColor Green; Write-Host ('  Rapor : ' + $cikti) -ForegroundColor Green; Start-Process $ac; Start-Process notepad.exe $cikti"
echo.
pause
