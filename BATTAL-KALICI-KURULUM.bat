@echo off
chcp 65001 >nul
title BATTAL MUHASEBE - Kalici Kurulum
setlocal
set "GIRDI=%~1"
echo.
echo  ==================================================
echo    BATTAL MUHASEBE - KALICI KURULUM
echo    Paket Masaustu\BATTAL-MUHASEBE-PANEL altina
echo    tasinir ve kisayol olusturulur.
echo  ==================================================
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='SilentlyContinue'; $masa=[Environment]::GetFolderPath('Desktop'); $ac=Join-Path $masa 'KURTARILAN-ZIP\_acilmis'; $girdi='%GIRDI%'; $ana=$null; if($girdi -and (Test-Path -LiteralPath $girdi)){ $ana=Get-Item -LiteralPath $girdi }; if(-not $ana){ if(-not (Test-Path -LiteralPath $ac)){ Write-Host '  [HATA] _acilmis klasoru yok. Once ZIP-KURTARMA.bat calistirin.' -ForegroundColor Red; exit 1 }; $adaylar=@(Get-ChildItem -LiteralPath $ac -Recurse -File -Filter 'BATTAL-MUHASEBE.html' -ErrorAction SilentlyContinue); if($adaylar.Count -eq 0){ Write-Host '  [HATA] BATTAL-MUHASEBE.html bulunamadi.' -ForegroundColor Red; exit 1 }; $enIyi=$null; $enCok=-1; foreach($a in $adaylar){ $kardes=@(Get-ChildItem -LiteralPath $a.DirectoryName -File -ErrorAction SilentlyContinue | Where-Object { $_.Extension -match '^\.html?$' }).Count; if($kardes -gt $enCok){ $enCok=$kardes; $enIyi=$a } }; $ana=$enIyi }; Write-Host ('  Panel      : ' + $ana.FullName); $panelKlasor=$ana.DirectoryName; $kok=$panelKlasor; if((Split-Path $panelKlasor -Leaf) -match '(?i)^PANELLER$'){ $kok=Split-Path $panelKlasor -Parent }; Write-Host ('  Paket koku : ' + $kok); $hedef=Join-Path $masa 'BATTAL-MUHASEBE-PANEL'; if(Test-Path -LiteralPath $hedef){ $yedek=$hedef + '-onceki-' + (Get-Date).ToString('yyyyMMdd-HHmmss'); Rename-Item -LiteralPath $hedef -NewName (Split-Path $yedek -Leaf); Write-Host ('  Eski klasor yedeklendi: ' + (Split-Path $yedek -Leaf)) }; New-Item -ItemType Directory -Path $hedef | Out-Null; Copy-Item -Path (Join-Path $kok '*') -Destination $hedef -Recurse -Force; Write-Host ('  Kopyalandi : ' + $hedef); Write-Host ''; $yeniPanel = Join-Path $hedef ((Split-Path $ana.FullName -Parent).Substring($kok.Length).TrimStart('\') + '\' + $ana.Name); $yeniPanel = $yeniPanel -replace '\\\\','\'; if(-not (Test-Path -LiteralPath $yeniPanel)){ $b=@(Get-ChildItem -LiteralPath $hedef -Recurse -File -Filter 'BATTAL-MUHASEBE.html' -ErrorAction SilentlyContinue); if($b.Count -gt 0){ $yeniPanel=$b[0].FullName } }; Write-Host '  Klasordeki paneller:'; foreach($f in (Get-ChildItem -LiteralPath $hedef -Recurse -File -ErrorAction SilentlyContinue | Where-Object { $_.Extension -match '(?i)^\.(html?|bat|exe)$' } | Sort-Object Length -Descending)){ Write-Host ('     ' + ([math]::Round($f.Length/1KB,0)).ToString().PadLeft(7) + ' KB  ' + $f.FullName.Substring($hedef.Length)) }; Write-Host ''; $s=New-Object -ComObject WScript.Shell; $ad=[char]::ConvertFromUtf32(0x1F9FE) + ' BATTAL MUHASEBE.lnk'; $lnk=Join-Path $masa $ad; $k=$s.CreateShortcut($lnk); $k.TargetPath=$yeniPanel; $k.WorkingDirectory=(Split-Path $yeniPanel -Parent); $k.Description='Battal Muhasebe - tum paneller'; $k.Save(); if(Test-Path -LiteralPath $lnk){ Write-Host ('  [OK] Masaustu kisayolu: ' + $ad) -ForegroundColor Green; Write-Host ('       -> ' + $yeniPanel) } else { Write-Host '  [HATA] Kisayol olusturulamadi.' -ForegroundColor Red }; Write-Host ''; Write-Host '  Artik KURTARILAN-ZIP klasorunu silebilirsiniz; panel bu klasorde kalici.' -ForegroundColor Green; Start-Process (Split-Path $yeniPanel -Parent)"
echo.
pause
